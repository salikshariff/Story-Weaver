# Copy to .env and fill in. Never commit .env.

# Anthropic API key — the only secret in the app. It lives on the server
# and is never shipped to the browser.
ANTHROPIC_API_KEY=sk-ant-...

# Model used for story generation.
STORY_MODEL=claude-sonnet-5-5

# Port the Express server listens on. In dev, Vite proxies /api here.
PORT=8787

# Comma-separated origins allowed to call the API. Leave unset in production
# when the server also serves the built client from the same origin.
# CORS_ORIGINS=http://localhost:5173
